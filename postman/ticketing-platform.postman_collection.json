{
  "info": {
    "name": "Ticketing Platform",
    "description": "Flows of the reactive ticketing API. Run the folders in order: Events, Purchase flow, Complimentary, Errors. Variables eventId, orderId and idempotencyKey are captured by test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "Create event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rock Night\",\n  \"date\": \"2035-06-01T20:00:00Z\",\n  \"venue\": \"Arena\",\n  \"capacity\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates the event and its 50 ticket items (all AVAILABLE). Captures eventId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"has id and capacity\", () => { pm.expect(body.id).to.be.a(\"string\"); pm.expect(body.capacity).to.eql(50); });",
                  "pm.collectionVariables.set(\"eventId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            },
            "description": "Holds (RESERVED + PENDING_CONFIRMATION) are not sales: they reduce `available` but not `sold`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"counts add up to capacity\", () => pm.expect(a.available + a.reserved + a.pendingConfirmation + a.sold + a.complimentary).to.eql(a.capacity));"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability stream (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability",
                "stream"
              ]
            },
            "description": "Server-sent events: current availability, then a new event whenever it changes (checked every 2s). Postman keeps the connection open: cancel the request manually. With curl use `curl -N`."
          }
        }
      ]
    },
    {
      "name": "2. Purchase flow",
      "item": [
        {
          "name": "Purchase 2 tickets (new Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"customerId\": \"customer-001\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns 202 immediately; the SQS consumer reserves the tickets asynchronously."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", \"pm-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"order accepted as PENDING\", () => { pm.expect(body.orderId).to.be.a(\"string\"); pm.expect(body.status).to.eql(\"PENDING\"); });",
                  "pm.test(\"Location header points at the order\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(body.orderId));",
                  "pm.collectionVariables.set(\"orderId\", body.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same Idempotency-Key (no duplicate order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"customerId\": \"customer-001\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Retrying a timed-out request is safe: same customer + key returns the original order."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"same orderId returned\", () => pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"orderId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order status (poll until PENDING_CONFIRMATION)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Run it a few times: PENDING -> RESERVED -> PENDING_CONFIRMATION. `ticketStatus` and `tickets[]` show the ticket states."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test(\"known status\", () => pm.expect([\"PENDING\",\"RESERVED\",\"PENDING_CONFIRMATION\",\"CONFIRMED\",\"REJECTED\",\"EXPIRED\"]).to.include(o.status));",
                  "if (o.status === \"PENDING\" || o.status === \"RESERVED\") { console.log(\"Still processing, send this request again\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability while held",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"tickets held, nothing sold yet\", () => { const a = pm.response.json(); pm.expect(a.sold).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm purchase",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "confirm"
              ]
            },
            "description": "Must be called before the reservation expires (10 minutes). Confirming twice is idempotent. After expiry: 410 Gone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"order CONFIRMED, tickets SOLD\", () => { const o = pm.response.json(); pm.expect(o.status).to.eql(\"CONFIRMED\"); pm.expect(o.ticketStatus).to.eql(\"SOLD\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability after confirmation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"2 sold\", () => pm.expect(pm.response.json().sold).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Complimentary tickets",
      "item": [
        {
          "name": "Complimentary tickets (with admin token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/complimentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "complimentary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"tickets are COMPLIMENTARY\", () => pm.response.json().forEach(t => pm.expect(t.status).to.eql(\"COMPLIMENTARY\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complimentary tickets (without token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/complimentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "complimentary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Error cases",
      "item": [
        {
          "name": "Unknown event -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/does-not-exist/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "does-not-exist",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed id -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/bad%20id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "bad%20id"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation error (capacity 0) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"date\": \"2035-06-01T20:00:00Z\",\n  \"venue\": \"y\",\n  \"capacity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase without Idempotency-Key -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"customerId\": \"customer-001\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase for unknown event -> 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "pm-unknown-event"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"does-not-exist\",\n  \"customerId\": \"customer-001\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different payload -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"customerId\": \"customer-001\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run after the purchase flow: the key is bound to the first payload (quantity 2)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown order -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm unknown order -> 404",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/does-not-exist/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "does-not-exist",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "prometheus"
              ]
            },
            "description": "Includes order counters. Rate limiting (429 + Retry-After) triggers after ~50 quick requests per client."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": "local-admin-token"
    }
  ]
}